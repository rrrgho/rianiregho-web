# Copy to `.env.production` on the server (same folder as docker-compose.yml)
# and fill in the values. This file is read by `docker compose`; never commit it.

# --- Database ---------------------------------------------------------------
# Postgres runs in the `pgdb` container and is published on the host's 5432.
# From inside this container the host is `host.docker.internal`.
# URL-encode special characters in the password (e.g. ? -> %3F, @ -> %40).
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@host.docker.internal:5432/rianiregho_web

# --- Auth -------------------------------------------------------------------
# Signs the login session cookie. Generate with:  openssl rand -base64 32
# Changing it logs everyone out.
AUTH_SECRET=
# Required behind Apache: take the host/protocol from the proxied request.
AUTH_TRUST_HOST=true

# --- Uploads ----------------------------------------------------------------
# Path INSIDE the container (mapped to a host folder by docker-compose.yml).
UPLOAD_DIR=/data/uploads
